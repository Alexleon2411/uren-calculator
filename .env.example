# Copy this file to .env and adjust the values.
# npm start loads it automatically (Node 24 --env-file-if-exists).

PORT=3000
HOST=0.0.0.0
DATA_DIR=./data
APP_TZ=Europe/Amsterdam

# Public address used in the manager link (e.g. https://uren.example.com).
# Leave empty to use the current browser address / local network IP.
PUBLIC_URL=

# Set both to true when the app is behind HTTPS / a reverse proxy.
TRUST_PROXY=false
COOKIE_SECURE=false

# Hosted deployments: import seed/legacy-data.json when the database is empty.
SEED_ON_EMPTY=false

NODE_ENV=production
