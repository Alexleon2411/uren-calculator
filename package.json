{
  "name": "uren",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Time registration for MAGVIEW — daily hours, leave, Excel/PDF reports and a read-only manager link.",
  "scripts": {
    "dev:api": "node --watch --env-file-if-exists=.env server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "import:legacy": "node --env-file-if-exists=.env server/import-legacy.js",
    "import:legacy:replace": "node --env-file-if-exists=.env server/import-legacy.js --replace",
    "test": "node --test test/api.test.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "lucide-react": "^1.71.0",
